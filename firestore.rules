rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role checks. Costs a document read internally, but Firestore doesn't
    // charge/rate-limit rule-internal get()s against the caller the way a
    // client read would be.
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == "admin"; }
    function isOwner() { return isSignedIn() && myRole() == "owner"; }
    function isTenant() { return isSignedIn() && myRole() == "tenant"; }
    function isStaff() { return isAdmin() || isOwner(); }

    // ── users ──────────────────────────────────────────────────────────
    // Owner/admin/tenant login and forgot-password screens used to look a
    // user up by username/email directly against this collection BEFORE
    // Firebase Auth sign-in succeeded, which meant `users` had to stay
    // fully public (`allow get, list: if true`) -- letting anyone dump
    // every user's name/email/phone with one unauthenticated query. Those
    // lookups now run server-side via Cloud Functions (resolveLoginEmail,
    // tenantForgotPassword, adminForgotPassword -- see
    // functions/src/index.ts), which use the Admin SDK and bypass these
    // rules entirely, so reads can require auth like everything else here.
    match /users/{userId} {
      // A signed-in user can read their own doc; staff can read anyone's.
      allow get: if isSignedIn() && (isStaff() || request.auth.uid == userId);
      // Only staff run unfiltered/`where`-filtered queries against this
      // collection (tenant lists, admin lookups, etc.) -- no screen for a
      // plain tenant does a `list` here.
      allow list: if isStaff();

      // Account provisioning is server-only so Auth, user, and stall state
      // are committed through one guarded workflow.
      allow create: if false;

      // Sensitive profile and session fields are updated only through Cloud
      // Functions, where recent-authentication and cross-document consistency
      // can be enforced. Direct self-writes are limited to device metadata.
      // may never change their own role/status -- otherwise a tenant could
      // simply write role:"admin" on their own doc. price/paymentSchedule
      // are a tenant's actual billing terms (moved here from the stall doc
      // so they travel with a tenant on relocation) and must stay
      // admin-only even on the tenant's own doc, same reasoning -- a
      // tenant could otherwise just set their own rent to ₱0. `category`
      // stays self-editable (business type, not money). Staff can update
      // any tenant doc (archive/restore/relocate) without any of these
      // restrictions.
      // Enforce the role hierarchy in the backend. Staff may manage only
      // lower-level accounts, nobody may rewrite a role, and self-service
      // writes are limited to fields used by profile/session screens.
      allow update: if
        (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "expoPushToken",
            "emailVerified"
          ]));

      allow delete: if false;
    }

    // ── stalls ─────────────────────────────────────────────────────────
    // Guests receive a safe field projection from the getPublicStalls Cloud
    // Function; raw documents remain available only to authenticated apps.
    match /stalls/{stallId} {
      allow read: if isSignedIn();
      // Occupancy and rent changes must remain coordinated with the tenant
      // document, so every mutation goes through Cloud Functions.
      allow create, update, delete: if false;
    }

    // One sanitized cache document powers the public Guest map. The backend
    // alone writes it; guests receive live availability without access to
    // tenant identities, contact details, or payment records.
    match /publicApiCache/stalls {
      allow read: if true;
      allow write: if false;
    }

    // ── payments ───────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isStaff()
        || (isTenant() && resource.data.userId == request.auth.uid);

      // All payment creation and mutation goes through authenticated Cloud
      // Functions. This prevents modified Admin/Owner/Tenant clients from
      // fabricating amounts, statuses, provider references, or approvals.
      allow create, update, delete: if false;
    }

    // ── updates (audit log / tenant reports) ──────────────────────────
    match /updates/{updateId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      // Owner flips approvalStatus when reviewing; admin stamps notifiedAt
      // on its own previously-created updates once it's reported them to
      // the owner (UpdatesReportFAB's "Apply Changes").
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notifiedAt"]);
    }

    // ── notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Staff need read on top of self-scoped read: some staff queries
      // (e.g. owner looking up notifications by updateId when acknowledging
      // an admin's report) filter on a field other than userId, and
      // Firestore rejects a list query outright unless its own `where`
      // clause matches what the rule checks -- the self-scoped branch alone
      // can't cover that, but isStaff() doesn't depend on resource.data at
      // all, so it satisfies Firestore's list-query proof regardless of
      // how the query is filtered.
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Staff fan notifications out to other users (tenant<->owner<->admin).
      allow create: if isStaff() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    // ── ownerRecovery ──────────────────────────────────────────────────
    // Cloud Functions only (Admin SDK bypasses rules entirely) -- no
    // client, including a signed-in owner, ever needs direct access.
    match /ownerRecovery/{ownerId} {
      allow read, write: if false;
    }

    // ── rateLimits ───────────────────────────────────────────────────
    // Cloud Functions only (Admin SDK bypasses rules entirely) -- internal
    // per-endpoint attempt counters (see checkRateLimit in
    // functions/src/index.ts). No client ever needs direct access; letting
    // one write here would let it reset/inflate its own rate limit.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ── passwordResetOtps ──────────────────────────────────────────────
    // Cloud Functions only (Admin SDK bypasses rules entirely) -- holds the
    // hashed, short-lived SMS reset codes issued by sendResetOtp and consumed
    // by verifyResetOtp (see functions/src/index.ts). No client, signed-in or
    // not, ever reads or writes these; a client that could would be able to
    // read/reset the attempt counter or the code hash.
    match /passwordResetOtps/{docId} {
      allow read, write: if false;
    }

    // Server-created PayMongo sessions bind a validated amount and payment
    // intent to one tenant and are consumed atomically by Cloud Functions.
    match /paymentSessions/{sessionId} {
      allow read, write: if false;
    }

    // Server-only payment creation mutexes and webhook idempotency records.
    match /paymentAttemptLocks/{tenantId} {
      allow read, write: if false;
    }
    match /paymongoWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ── passwordResetRequests ──────────────────────────────────────────
    // Reset requests are created by the validated/rate-limited callable
    // functions. The Admin SDK bypasses rules, so clients need no write path.
    match /passwordResetRequests/{requestId} {
      allow create: if false;
      allow read, update: if isStaff();
      allow delete: if isStaff();
    }

    // ── AR (guest site, public, unauthenticated) ───────────────────────
    match /arObjects/{objectId} {
      allow read: if true;
      allow write: if false;
    }
    // Anonymous writes are validated and rate-limited by a Cloud Function.
    match /arPlacementEvents/{eventId} {
      allow create: if false;
      allow read, update, delete: if false;
    }

    // Anonymous writes are validated and rate-limited by a Cloud Function.
    match /contactMessages/{messageId} {
      allow create: if false;
      allow read, delete: if isStaff();
      allow update: if false;
    }

    // ── settings (admin-configurable app settings, e.g. reminder time) ─
    // Read/write requires admin -- the reminder Cloud Function itself uses
    // the Admin SDK and bypasses these rules, so this only gates the client.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ── archives / dailyReports (owner + admin only) ───────────────────
    match /archives/{archiveId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /dailyReports/{reportId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
