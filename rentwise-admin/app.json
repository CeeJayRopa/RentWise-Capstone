{
  "expo": {
    "name": "RentWise",
    "slug": "rentwise-admin",
    "scheme": "rentwiseadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/admin-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E6B54",
        "foregroundImage": "./assets/admin-icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.rentwiseadmin",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A227",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/admin-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#0E6B54"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "803faa4d-40f6-4255-a4ad-e903d325e631"
      }
    },
    "owner": "rentwise"
  }
}
