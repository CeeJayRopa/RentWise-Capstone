# Copy this file to .env and fill in real values. Never commit the real .env.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rentwise
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=https://rentwise-kadomeng.site
PORT=4000

# Client apps will read EXPO_PUBLIC_BACKEND=mongo (vs. "firebase") once the
# shared/firebaseConfig.ts switch described in MONGODB_BACKUP_ROADMAP.md is
# built -- that variable lives in each app's own .env, not here.
